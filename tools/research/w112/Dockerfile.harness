FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
RUN apt-get update && apt-get install -y --no-install-recommends \
    git chromium xvfb xauth x11-utils libx11-6 libxtst6 libxrandr2 libxinerama1 libxcursor1 libxi6 \
    scrot xsel python3-tk fonts-liberation ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.13.6
COPY harness /opt/northcua
WORKDIR /opt/northcua
RUN uv sync --locked --python 3.12 --extra local --extra device
ENV PATH="/opt/northcua/.venv/bin:$PATH" PYTHONUNBUFFERED=1 HOME=/tmp/astra-home DISPLAY=:99
RUN useradd -u 1000 -m tester
USER tester
ENTRYPOINT ["/bin/bash"]
